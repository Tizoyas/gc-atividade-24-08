@startuml
title SISTAC - Diagrama de Casos de Uso

left to right direction

actor "Aluno" as Aluno
actor "Professor" as Professor
actor "Administrador" as Admin

rectangle "SISTAC - Sistema Acadêmico" {

  usecase "Realizar login" as UC01

  usecase "Realizar matrícula" as UC02
  usecase "Consultar notas" as UC03
  usecase "Consultar frequência" as UC04

  usecase "Lançar notas" as UC05
  usecase "Registrar faltas" as UC06
  usecase "Consultar turmas" as UC07

  usecase "Gerenciar cursos" as UC08
  usecase "Gerenciar disciplinas" as UC09
  usecase "Gerenciar professores" as UC10
  usecase "Gerenciar alunos" as UC11
  usecase "Gerenciar turmas" as UC12
  usecase "Gerenciar matrículas" as UC13
}

Aluno --> UC01
Aluno --> UC02
Aluno --> UC03
Aluno --> UC04

Professor --> UC01
Professor --> UC05
Professor --> UC06
Professor --> UC07

Admin --> UC01
Admin --> UC08
Admin --> UC09
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13

@enduml
